rules_version = '2';

// Paste this into Firebase Console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'ieltsvocabmaster@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Book range and home module sections: everyone reads, only the admin writes.
    match /site/{docId} {
      allow read: if true;
      allow write: if isAdmin() && docId in ['bookRange', 'moduleSections'];
    }

    // Slider banners.
    match /banners/{bannerId} {
      allow read: if true;
      allow create, delete: if isAdmin();
    }

    // Daily notifications: everyone reads, only the admin posts or deletes.
    match /notifications/{notificationId} {
      allow read: if true;
      allow create, delete: if isAdmin();
    }

    // Vocabulary and module content uploaded from the admin panel.
    match /content/{contentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Each user can read and write only their own profile and progress,
    // but never the "premium" and "premiumUntil" fields: only the admin can grant premium and its end date.
    match /users/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }
      allow read: if isOwner() || isAdmin();
      allow create: if (isOwner() && !('premium' in request.resource.data) && !('premiumUntil' in request.resource.data)) || isAdmin();
      allow update: if (isOwner() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['premium', 'premiumUntil'])) || isAdmin();
      allow delete: if isAdmin();
    }
  }
}
