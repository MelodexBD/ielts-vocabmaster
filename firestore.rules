rules_version = '2';

// Paste this into Firebase Console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'ieltsvocabmaster@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Book range and home module sections: everyone reads, only the admin writes.
    match /site/{docId} {
      allow read: if true;
      allow write: if isAdmin() && docId in ['bookRange', 'moduleSections'];
    }

    // Slider banners.
    match /banners/{bannerId} {
      allow read: if true;
      allow create, delete: if isAdmin();
    }

    // Vocabulary and module content uploaded from the admin panel.
    match /content/{contentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Each user can read and write only their own profile and progress.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
